<?xml version='1.0' encoding='utf-8'?>
<widget id="com.komura.tasklab" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
  <name>TaskLab</name>
  <description>Gestor de tareas</description>
  <content src="index.html" />
  <access origin="*" />
  <preference name="scheme" value="app" />
  <preference name="hostname" value="localhost" />
  <preference name="AndroidXEnabled" value="true" />

  <platform name="android">
    <resource-file src="resources/android/values/tasklab_colors.xml" target="/app/src/main/res/values/tasklab_colors.xml" />
    <icon density="ldpi" src="resources/android/icon/drawable-ldpi-icon.png" foreground="resources/android/icon/ldpi-foreground.png" background="@color/tasklab_icon_background" />
    <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" foreground="resources/android/icon/mdpi-foreground.png" background="@color/tasklab_icon_background" />
    <icon density="hdpi" src="resources/android/icon/drawable-hdpi-icon.png" foreground="resources/android/icon/hdpi-foreground.png" background="@color/tasklab_icon_background" />
    <icon density="xhdpi" src="resources/android/icon/drawable-xhdpi-icon.png" foreground="resources/android/icon/xhdpi-foreground.png" background="@color/tasklab_icon_background" />
    <icon density="xxhdpi" src="resources/android/icon/drawable-xxhdpi-icon.png" foreground="resources/android/icon/xxhdpi-foreground.png" background="@color/tasklab_icon_background" />
    <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" foreground="resources/android/icon/xxxhdpi-foreground.png" background="@color/tasklab_icon_background" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/icon/xxxhdpi-foreground.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0C0C13" />
  </platform>

  <platform name="ios">
    <icon src="resources/ios/icon/icon-1024.png" width="1024" height="1024" />
    <splash src="resources/ios/splash/Default@2x~universal~anyany.png" />
  </platform>
</widget>
